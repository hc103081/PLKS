{
	"extends": "../../packages/config/tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": ".",
		"composite": true,
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*", "tests/**/*", "vite.config.ts"],
	"exclude": ["node_modules", "dist"]
}
